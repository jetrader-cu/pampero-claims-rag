# ==============================================================================
# Pampero Claims Assistant — Variables de entorno de ejemplo
# ==============================================================================

# Entorno
ENVIRONMENT=development
DEBUG=true

# Base de datos (PostgreSQL 17 + pgvector)
POSTGRES_DB=pampero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_DB_USER=pampero_app
APP_DB_PASSWORD=pampero_app_secret

# URLs de conexión SQLAlchemy
# Para la API HTTP (asíncrono, rol pampero_app)
DATABASE_URL=postgresql+asyncpg://pampero_app:pampero_app_secret@localhost:5432/pampero
# Para Celery sync y scripts (síncrono, rol pampero_app)
DATABASE_SYNC_URL=postgresql+psycopg://pampero_app:pampero_app_secret@localhost:5432/pampero
# Para migraciones Alembic (síncrono, rol propietario postgres)
DATABASE_URL_OWNER=postgresql+psycopg://postgres:postgres@localhost:5432/pampero

# Redis y Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Tokens y seguridad
ADMIN_TOKEN=pampero-dev-admin-token
SECRET_KEY=dev-secret-key-change-in-production

# Proveedores de LLM y Embeddings (fake | litellm)
LLM_PROVIDER=fake
LLM_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=openai/gpt-4.1-mini
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=1536

# Claves de proveedores (opcionales con LLM_PROVIDER=fake)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ingesta y RAG
PARSER=pypdf
RAG_MIN_SIMILARITY=0.30
STORAGE_PATH=./data/uploads

# OpenTelemetry (Jaeger / Grafana LGTM)
OTEL_SERVICE_NAME=pampero-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_always_on

# Puertos de servicios
WEB_PORT=5173
API_PORT=8000
GRAFANA_PORT=3000
